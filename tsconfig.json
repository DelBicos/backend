{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": ".",
    "types": ["node", "jest"],
    "removeComments": false
  },
  "include": ["src/**/*.ts", "ticketCode.ts"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}
