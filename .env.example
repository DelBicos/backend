IS_SERVERLESS=false

ALLOWED_ORIGINS=https://seu-app.vercel.app,https://www.seudominio.com.br,http://localhost:8081

# ============================================================
# E-MAIL (SMTP) - padrao Gmail com senha de app (gratuito, ~500/dia)
# Gere a senha em https://myaccount.google.com/apppasswords
# (a conta precisa ter verificacao em duas etapas ativada).
# ============================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=
# Remetente (no Gmail, use a propria conta do SMTP_USER)
SENDER_EMAIL_VERIFICADO=seuemail@gmail.com
SENDER_NAME=DelBicos

# ============================================================
# STRIPE
# ============================================================
STRIPE_SECRET_KEY=sk_test_sua_stripe_key_aqui

# ============================================================
# DATABASE CONFIGURATION - Choose one strategy below
# ============================================================
ENVIRONMENT=development
SEQUELIZE_DB_NAME=delbicos
SEQUELIZE_DB_USER=delbicos
SEQUELIZE_DB_PASS=postgres123
SEQUELIZE_HOST=localhost
SEQUELIZE_PORT=5432
SEQUELIZE_DIALECT=postgres

# ============================================================
# OPTIONAL DATABASE FLAGS
# ============================================================
DB_LOGGING=false

# ============================================================
# AUTHENTICATION
# ============================================================
# OBRIGATORIA: o servidor nao sobe sem ela. Use 32+ caracteres aleatorios
# (ex.: openssl rand -hex 32). Trocar a chave desloga todos os usuarios.
SECRET_KEY=troque_por_um_segredo_aleatorio_de_no_minimo_32_caracteres
EXPIRES_IN=24h

# ============================================================
# SEGURANCA HTTP (opcionais, valores padrao entre parenteses)
# ============================================================
# Saltos de proxy confiaveis para obter o IP real (1 no Azure App Service)
TRUST_PROXY_HOPS=1
# Tamanho maximo do corpo JSON (2mb)
JSON_BODY_LIMIT=2mb
# Limites por IP. Global: requisicoes por minuto (600; desligado em
# development). Cadastro/verificacao (20) e logins com falha (10): a cada 15 min.
GLOBAL_RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=20
LOGIN_RATE_LIMIT_MAX=10

# ============================================================
# FILE UPLOAD / STORAGE
# ============================================================
# Usada apenas com STORAGE_PROVIDER=imgbb
IMGBB_API_KEY=sua_api_key_aqui

# ============================================================
# MONITORING & LOGGING
# ============================================================
LOGTAIL_TOKEN=seu_token_logtail_aqui
ENABLE_LOGTAIL=false
LOG_LEVEL=info

# ============================================================
# EXTERNAL SERVICES
# ============================================================
MONGODB_URI=mongodb://localhost:27017/logs_db
# Local: localhost. Docker Compose: mongodb://mongo:27017/delbicos_chat
MONGODB_CHAT_URI=mongodb://localhost:27017/delbicos_chat

# ============================================================
# ARMAZENAMENTO DE IMAGENS (Azure Blob Storage)
# ============================================================
# "azure" ou "imgbb". Sem valor: azure se houver connection string, senao imgbb.
STORAGE_PROVIDER=azure
# Azure Portal > Storage account > Access keys > Connection string.
# Local (emulador Azurite): UseDevelopmentStorage=true
#   docker run -p 127.0.0.1:10000:10000 mcr.microsoft.com/azure-storage/azurite azurite-blob --blobHost 0.0.0.0
AZURE_STORAGE_CONNECTION_STRING=
# Container das imagens (criado sozinho, com leitura publica dos blobs).
# Em contas com acesso publico desativado, habilite em Configuration > Allow Blob anonymous access.
# CORS da conta (Resource sharing): metodos PUT/GET/OPTIONS, cabecalhos x-ms-blob-type e Content-Type.
AZURE_STORAGE_CONTAINER=delbicos-uploads
# Container PRIVADO (documentos de identidade): sem leitura publica, so URL assinada
AZURE_PRIVATE_CONTAINER=delbicos-private

# ============================================================
# E-MAIL DE FALLBACK (Azure Function, opcional, usada se o SMTP falhar)
# ============================================================
AZURE_FUNCTION_URL=
AZURE_FUNCTION_KEY=
AZURE_FUNCTION_TIMEOUT_MS=20000

# ============================================================
# CHATBOT / NLU — TF-IDF + SVM, sem IA generativa
# ============================================================
# App Service do Azure que hospeda o classificador Python (antes era um
# hostname interno do Docker Compose; migrado para o App Service nativo).
NLU_SERVICE_URL=https://delbicos-nlu.azurewebsites.net

# Chave compartilhada exigida pelo nlp-service (header X-API-Key). Sem ela,
# toda chamada a /classify e /semantic-search e recusada com 401 (falha
# fechado). Mesmo valor precisa estar configurado como App Setting no
# App Service delbicos-nlu.
NLU_SERVICE_API_KEY=troque-por-um-segredo-forte

# Confiança mínima para aceitar uma intenção; abaixo dela, retorna FALLBACK.
NLU_CONFIDENCE_THRESHOLD=0.65

# Timeout máximo (ms) da chamada ao classificador interno.
NLU_CLASSIFIER_TIMEOUT_MS=1000

# Busca semântica de serviços (embeddings multilíngues no nlp-service).
# Timeout máximo da chamada Node -> nlp-service.
SEMANTIC_SEARCH_TIMEOUT_MS=5000

# Similaridade mínima aceita (-1 a 1) e quantidade máxima de melhores resultados
# pagináveis que a API semântica mantém por consulta.
SEMANTIC_MIN_SCORE=0.35
SEMANTIC_SEARCH_RESULT_LIMIT=200

# Cache em memória dos embeddings de documentos no nlp-service (0 desativa).
SEMANTIC_EMBEDDING_CACHE_SIZE=5000

# Modelo carregado pelo nlp-service. Ele é baixado durante a montagem da imagem Docker.
SEMANTIC_MODEL_NAME=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Transcrição de voz. Providers suportados: azure (Azure Speech Service), deepgram (padrão em produção),
# openai-compatible (qualquer endpoint multipart no formato OpenAI/Whisper) ou mock (local).
# A chave de API deve ficar exclusivamente no backend (Key Vault / App Settings) e nunca no frontend.
VOICE_TRANSCRIPTION_PROVIDER=azure
VOICE_TRANSCRIPTION_URL=
VOICE_TRANSCRIPTION_API_KEY=
VOICE_TRANSCRIPTION_MODEL=
AZURE_SPEECH_KEY=sua_chave_azure_speech_key_vault
AZURE_SPEECH_REGION=brazilsouth
# Orçamento total da transcrição (timeout configurável em ms).
VOICE_TRANSCRIPTION_TIMEOUT_MS=45000

# Reuso seguro de uma resposta quando o app repete o mesmo Idempotency-Key.
VOICE_COMMAND_IDEMPOTENCY_TTL_MS=600000
VOICE_COMMAND_IDEMPOTENCY_MAX_ENTRIES=10000

# Sessões de chat mais antigas são encerradas e não restauradas automaticamente.
BOT_SESSION_TTL_HOURS=24
