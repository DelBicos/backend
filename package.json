{
  "name": "my-vercel-express-app",
  "version": "5.9.1",
  "description": "",
  "main": "server.ts",
  "scripts": {
    "query": "node query.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "tsc --noEmit",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only ./server.ts",
    "migrate:db:create": "npx sequelize-cli db:create",
    "migrate": "npx sequelize-cli db:migrate",
    "migrate:new": "npx sequelize-cli migration:generate --name",
    "migrate:undo:all": "npx sequelize-cli db:migrate:undo:all",
    "migrate:undo": "npx sequelize-cli db:migrate:undo",
    "migrate:reset": "npm run migrate:undo:all && npm run migrate",
    "seed:create": "npx sequelize-cli seed:generate --name",
    "seed:undo:all": "npx sequelize-cli db:seed:undo:all",
    "seed:undo": "npx sequelize-cli db:seed:undo",
    "seed": "npx sequelize-cli db:seed:all",
    "seed:reset": "npm run seed:undo:all && npm run seed",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:dev": "docker-compose exec delbicos-server npm run dev",
    "docker:exec": "docker-compose exec delbicos-server sh",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:restart": "docker-compose restart",
    "docker:restart:postgres": "docker-compose restart postgres",
    "docker:clean": "docker-compose down -v --remove-orphans",
    "docker:clean:images": "docker-compose down && docker system prune -f",
    "docker:clean:all": "docker-compose down -v --remove-orphans && docker system prune -af --volumes",
    "docker:rebuild": "docker-compose down && docker-compose build --no-cache && docker-compose up -d",
    "docker:copy:env": "docker cp .env server-delbicos:/app/.env",
    "docker:network": "docker network create delbicos-shared-network",
    "docker:migrate": "docker-compose exec delbicos-server npm run migrate",
    "docker:seed": "docker-compose exec delbicos-server npm run seed",
    "test": "jest",
    "test:unit": "jest --selectProjects unit --no-coverage",
    "test:integration": "jest --selectProjects integration --no-coverage",
    "test:all": "jest --no-coverage"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch-logs": "^3.0.0",
    "@aws-sdk/client-lambda": "^3.1038.0",
    "@aws-sdk/client-s3": "^3.1037.0",
    "@aws-sdk/lib-storage": "^3.1037.0",
    "@aws-sdk/s3-request-presigner": "^3.1038.0",
    "@logtail/node": "^0.5.6",
    "@logtail/winston": "^0.5.6",
    "@sendgrid/mail": "^8.1.5",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "expo": "^55.0.17",
    "expo-server-sdk": "^4.0.0",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.3.2",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.14.1",
    "mysql2": "^3.22.0",
    "nanoid": "^3.3.7",
    "node-cron": "^4.2.1",
    "pg": "^8.16.3",
    "sequelize": "^6.37.8",
    "socket.io": "^4.8.3",
    "stripe": "^19.1.0",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^8.3.2",
    "winston": "^3.18.3",
    "winston-cloudwatch": "^6.3.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.23",
    "@types/express-rate-limit": "^5.1.3",
    "@types/helmet": "^0.0.48",
    "@types/hpp": "^0.2.7",
    "@types/jest": "29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^16.11.7",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^6.0.3",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uuid": "^8.3.2",
    "jest": "~29.7.0",
    "jest-util": "^29.7.0",
    "nodemon": "^3.1.10",
    "sequelize-cli": "^6.6.3",
    "supertest": "^6.3.3",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.4.0",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "license": "MIT",
  "keywords": [],
  "author": ""
}
